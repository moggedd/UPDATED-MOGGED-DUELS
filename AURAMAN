	local function flashQuickBorder(button, duration)
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if not stroke then return end
		-- instant: applied on the same frame the press/keybind is seen
		local generation = (tonumber(button:GetAttribute("BorderFlashGen")) or 0) + 1
		button:SetAttribute("BorderFlashGen", generation)
		button:SetAttribute("BorderFlashing", true)
		local color0, transparency0, thickness0 = stroke.Color, stroke.Transparency, stroke.Thickness
		-- pure BLUE glow (no white), applied the same frame the button is pressed
		local accent = typeof(_G.__CrystalCurtAccent) == "Color3" and _G.__CrystalCurtAccent or Color3.fromRGB(86, 164, 255)
		stroke.Color = accent
		stroke.Transparency = 0
		stroke.Thickness = 2.4
		task.delay(duration or 0.15, function()
			-- a newer flash owns the stroke now, let it finish
			if (tonumber(button:GetAttribute("BorderFlashGen")) or 0) ~= generation then return end
			if stroke.Parent then
				if button:GetAttribute("QuickStayGlow") then
					-- any steady active-state glow must survive the flash ending
					local accent = typeof(_G.__CrystalCurtAccent) == "Color3" and _G.__CrystalCurtAccent or Color3.fromRGB(86, 164, 255)
					stroke.Color = accent
					stroke.Transparency = 0
					stroke.Thickness = 2.4
				else
					stroke.Color = color0
					stroke.Transparency = transparency0
					stroke.Thickness = thickness0
				end
			end
			button:SetAttribute("BorderFlashing", nil)
			-- if the button toggled while flashing, repaint its current state immediately
			if _G.__CrystalRefreshQuickButtonTheme then pcall(_G.__CrystalRefreshQuickButtonTheme) end
			if _G.__CrystalSyncQuickButtonStates then pcall(_G.__CrystalSyncQuickButtonStates) end
		end)

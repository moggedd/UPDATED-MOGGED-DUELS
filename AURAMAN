	local function connectQuickButton(button, callback)
		local pressInput, pressPos, pressMoved = nil, nil, false
		local lastFire = 0
		local lastPressAt = 0
		local lastDragAt = 0

		local function pressFeedback(pressed)
			local scale = button:FindFirstChild("QuickPressScale")
			if not scale then return end
			TweenService:Create(scale, TweenInfo.new(pressed and 0.07 or 0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Scale = pressed and 0.93 or 1}):Play()
		end

		local function clearPress()
			pressInput, pressPos, pressMoved = nil, nil, false
		end

		-- single entry point so anything that can report a press is de-duplicated
		local function fire()
			if os.clock() - lastFire < 0.05 then return end   -- 50 ms guard: still allows fast double taps
			lastFire = os.clock()
			flashQuickBorder(button)   -- every mobile button glows blue the moment it is pressed
			if _G.__CrystalQuickDebug then print("[mogged hub] quick button fired: " .. tostring(button.Name)) end
			local ok, err = pcall(callback)
			if not ok then warn("[mogged hub] quick button " .. tostring(button.Name) .. " failed: " .. tostring(err)) end
			-- all on/off lights and halos update before this tap handler returns
